    "import numpy as np\n",
    "from astropy.io import fits            # reads/writes FITS files (the standard astronomy image format)\n",
    "from astropy.wcs import WCS             # handles the pixel <-> sky coordinate conversion\n",
    "from astropy.nddata import Cutout2D     # convenient tool for cropping a sub-image\n",
    "from astropy.wcs.utils import proj_plane_pixel_scales   # extracts the pixel scale from a WCS\n",
    "\n",
    "# Following the COWLS team's own preprocessing for this exact lens (they used\n",
    "# a 3.5\" mask radius), we make our cutout comfortably bigger than that, so we\n",
    "# have some margin/context around the region we'll eventually mask.\n",
    "cutout_size = 11.5 * u.arcsec\n",
    "\n",
    "with fits.open(fits_path) as hdul:\n",
    "    # A FITS file is organized into \"HDUs\" (Header Data Units) -- think of them\n",
    "    # as named sections. \"SCI\" is the actual science image; its header contains\n",
    "    # the WCS information.\n",
    "    sci_header = hdul[\"SCI\"].header\n",
    "    wcs = WCS(sci_header)\n",
    "\n",
    "    # .astype(float) ensures we're working with floating-point numbers, since\n",
    "    # raw FITS data can sometimes be stored in more restrictive formats.\n",
    "    sci_data = hdul[\"SCI\"].data.astype(float)     # the actual brightness/flux values, pixel by pixel\n",
    "    err_data = hdul[\"ERR\"].data.astype(float)     # the *uncertainty* on each pixel's flux (see Step 3)\n",
    "\n",
    "    # Cutout2D does the pixel-position lookup (via wcs) and slices out a small\n",
    "    # square of the data centered on our target, of the requested angular size.\n",
    "    sci_cutout = Cutout2D(sci_data, position=target_coord, size=cutout_size, wcs=wcs)\n",
    "    err_cutout = Cutout2D(err_data, position=target_coord, size=cutout_size, wcs=wcs)\n",
    "\n",
    "    # pixel_scale tells us how many arcseconds one pixel corresponds to --\n",
    "    # essential for converting between \"pixels\" and real angular/physical units\n",
    "    # later on (e.g. the Einstein radius is quoted in arcsec, not pixels).\n",
