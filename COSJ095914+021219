   "source": [
    "# Every MAST \"observation\" can have multiple associated data files (raw,\n",
    "# calibrated, different processing levels). We need the fully calibrated,\n",
    "# science-ready image -- in JWST terminology, a Level-3 \"i2d\" (drizzled/\n",
    "# resampled mosaic) FITS file.\n",
    "products = Observations.get_product_list(obs)\n",
    "\n",
    "science_products = Observations.filter_products(\n",
    "    products,\n",
    "    productSubGroupDescription=\"I2D\",   # I2D = the final calibrated image product\n",
    "    calib_level=3,                       # calibration level 3 = fully pipeline-processed\n",
    "    extension=\"fits\",                    # FITS is the standard astronomy file format\n",
    ")\n",
    "\n",
    "if len(science_products) == 0:\n",
    "    raise RuntimeError(\n",
    "        \"No level-3 '_i2d.fits' product found. Inspect `products` directly to \"\n",
    "        \"see what's available for this observation.\"\n",
    "    )\n",
    "\n",
    "print(f\"Downloading {len(science_products)} product(s)...\")\n",
    "# This actually downloads the file(s) to your computer, into output_dir\n",
    "manifest = Observations.download_products(science_products, download_dir=output_dir)\n",
    "\n",
    "print(manifest)\n",
    "\n",
    "if len(manifest) == 0:\n",
    "    raise RuntimeError(\"No files were downloaded.\")\n",
    "\n",
    "fits_path = manifest[\"Local Path\"][0]\n",
    "\n",
    "print(f\"Downloaded: {fits_path}\")\n"
   ]
