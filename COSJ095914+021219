    "import autolens as al   # the actual PyAutoLens library\n",
    "\n",
    "# BUG WORKAROUND #1: in this particular autolens install, some internal\n",
    "# functions expect `origin` and `pixel_scales` to always be (y, x) tuples, but\n",
    "# certain code paths pass in a single bare number instead, which crashes with\n",
    "# an IndexError. We patch the offending function so it coerces a bare number\n",
    "# into a proper tuple automatically -- this doesn't change any actual physics\n",
    "# or results, it just fixes a compatibility bug in this specific release.\n",
    "from autoarray.geometry import geometry_util as _geometry_util\n",
    "\n",
    "_original_central_scaled_coordinate_2d_from = _geometry_util.central_scaled_coordinate_2d_from\n",
    "\n",
    "def _patched_central_scaled_coordinate_2d_from(shape_native, pixel_scales, origin=(0.0, 0.0)):\n",
    "    if not isinstance(origin, (tuple, list)):\n",
    "        origin = (origin, origin)\n",
    "    if not isinstance(pixel_scales, (tuple, list)):\n",
    "        pixel_scales = (pixel_scales, pixel_scales)\n",
    "    return _original_central_scaled_coordinate_2d_from(\n",
    "        shape_native=shape_native, pixel_scales=pixel_scales, origin=origin\n",
    "    )\n",
    "\n",
    "_geometry_util.central_scaled_coordinate_2d_from = _patched_central_scaled_coordinate_2d_from\n",
    "\n",
    "# BUG WORKAROUND #1b: the exact same scalar-vs-tuple issue also shows up in a\n",
    "# third place -- over_sample_util.grid_2d_slim_over_sampled_via_mask_from,\n",
    "# which unpacks `pixel_scales` and `origin` directly as (y, x) pairs. We patch\n",
    "# this one too, the same way: coerce bare numbers into (value, value) tuples\n",
    "# before the original function runs.\n",
    "from autoarray.operators.over_sampling import over_sample_util as _over_sample_util\n",
    "\n",
    "_original_grid_2d_slim_over_sampled_via_mask_from = _over_sample_util.grid_2d_slim_over_sampled_via_mask_from\n",
    "\n",
    "def _patched_grid_2d_slim_over_sampled_via_mask_from(mask_2d, pixel_scales, sub_size, origin=(0.0, 0.0)):\n",
    "    if not isinstance(pixel_scales, (tuple, list)):\n",
    "        pixel_scales = (pixel_scales, pixel_scales)\n",
    "    if not isinstance(origin, (tuple, list)):\n",
    "        origin = (origin, origin)\n",
    "    return _original_grid_2d_slim_over_sampled_via_mask_from(\n",
    "        mask_2d=mask_2d, pixel_scales=pixel_scales, sub_size=sub_size, origin=origin\n",
    "    )\n",
    "\n",
    "_over_sample_util.grid_2d_slim_over_sampled_via_mask_from = _patched_grid_2d_slim_over_sampled_via_mask_from\n",
    "\n",
    "# F444W is a \"long wavelength\" NIRCam channel. Longer wavelengths diffract\n",
    "# more for a given telescope mirror size, so F444W has a coarser (blurrier)\n",
    "# resolution limit (~0.145 arcsec) than a shorter-wavelength filter like F150W\n",
    "# (~0.05 arcsec) would.\n",
    "fwhm_arcsec = 0.145   # Full Width at Half Maximum -- a standard way to describe a blur's \"width\"\n",
    "fwhm_pixels = fwhm_arcsec / pixel_scale\n",
    "\n",
    "# Converting FWHM to the \"sigma\" (standard deviation) parameter of a Gaussian:\n",
    "# this conversion factor (2.3548) comes from the mathematical relationship\n",
    "# between a Gaussian's FWHM and its standard deviation.\n",
    "sigma_pixels = fwhm_pixels / 2.3548\n",
    "\n",
    "psf_shape = (21, 21)   # size of the small PSF image we're building, in pixels\n",
    "y, x = np.mgrid[0:psf_shape[0], 0:psf_shape[1]]   # coordinate grids for every pixel in that 21x21 box\n",
    "y0, x0 = (psf_shape[0] - 1) / 2.0, (psf_shape[1] - 1) / 2.0   # the center of that box\n",
    "\n",
    "# The actual 2D Gaussian formula: brightness falls off with distance from center\n",
    "psf_array = np.exp(-(((x - x0) ** 2 + (y - y0) ** 2) / (2.0 * sigma_pixels ** 2)))\n",
    "psf_array /= psf_array.sum()   # normalize so all the PSF's values sum to 1 (conserves total flux when applied)\n",
    "\n",
    "dataset_path = \"dataset/COSJ095914+021219\"\n",
