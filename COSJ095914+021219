    "import os\n",
    "\n",
    "# Install astroquery if not already installed\n",
    "try:\n",
    "    import astroquery\n",
    "except ImportError:\n",
    "    !pip install astroquery\n",
    "\n",
    "from astroquery.mast import Observations   # Python interface to NASA's MAST archive\n",
    "from astropy.coordinates import SkyCoord    # represents a position on the sky (RA/Dec)\n",
    "import astropy.units as u                   # lets us attach physical units (degrees, arcsec) to numbers\n",
    "\n",
    "output_dir = \"jwst_COSJ095914+021219_data\"\n",
    "os.makedirs(output_dir, exist_ok=True)   # create a folder to store the downloaded FITS file, if it doesn't exist yet\n",
    "\n",
    "# SkyCoord stores a sky position. RA (Right Ascension) and Dec (Declination) are\n",
    "# the sky's version of longitude and latitude. Both are in degrees here.\n",
    "target_coord = SkyCoord(ra=149.811421524 * u.deg, dec=2.205440107 * u.deg)\n",
    "\n",
    "print(\"Querying MAST for JWST NIRCam COSMOS-Web imaging near COSJ095914+021219...\")\n",
    "\n",
    "# query_criteria asks MAST's database: \"give me observations matching these\n",
    "# filters.\" We're specifically asking for:\n",
    "#   - JWST data (\"obs_collection\")\n",
    "#   - taken with the NIRCam imaging instrument (not spectroscopy)\n",
    "#   - from proposal/program 1727 (COSMOS-Web's official program ID)\n",
    "#   - in the F444W filter (a specific near-infrared wavelength band, ~4.4 microns)\n",
    "#   - within 10 arcsec of our target coordinate (COSMOS-Web is tiled into many\n",
    "#     separate observations, so we search by position rather than assuming\n",
    "#     there's just one relevant observation, unlike a single-pointing program)\n",
    "obs_table = Observations.query_criteria(\n",
    "    obs_collection=\"JWST\",\n",
    "    instrument_name=\"NIRCAM/IMAGE\",\n",
    "    proposal_id=\"1727\",\n",
    "    #filters=\"F444W\",\n",
    "    coordinates=target_coord,\n",
    "    radius=\"10 arcsec\",\n",
    ")\n",
    "\n",
    "if len(obs_table) == 0:\n",
    "    raise RuntimeError(\n",
    "        \"No matching observations found. Try a larger search radius, or check \"\n",
    "        \"the current proposal_id for COSMOS-Web on MAST (it may have changed).\"\n",
    "    )\n",
    "\n",
    "obs = obs_table[3]   # just take the first matching observation\n",
    "print(f\"Found observation: {obs['obs_id']}\")\n",
    "\n",
    "#for obs in obs_table:\n",
    "    #print(f\"Found observation: {obs['obs_id']}\")\n",
    "#obs = obs_table[0]"
   ]
