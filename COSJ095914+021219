    "\n",
    "ny, nx = dataset.shape_native   # the (height, width) of our cutout, in pixels\n",
    "scale_y, scale_x = (dataset.pixel_scales, dataset.pixel_scales) \\\n",
    "    if isinstance(dataset.pixel_scales, (int, float)) else dataset.pixel_scales\n",
    "\n",
    "y0, x0 = (ny - 1) / 2.0, (nx - 1) / 2.0   # center of the image, in pixel coordinates\n",
