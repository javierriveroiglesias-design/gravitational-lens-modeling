    "im0 = axes[0].imshow(masked_image, cmap=\"gray\", vmin=vmin, vmax=vmax, origin=\"lower\")\n",
    "axes[0].set_title(\"Masked image\")\n",
    "plt.colorbar(im0, ax=axes[0], fraction=0.046)\n",
    "\n",
    "im1 = axes[1].imshow(np.where(dataset.mask, np.nan, dataset.noise_map.native), cmap=\"viridis\", origin=\"lower\")\n",
    "axes[1].set_title(\"Masked noise map\")\n",
    "plt.colorbar(im1, ax=axes[1], fraction=0.046)\n",
