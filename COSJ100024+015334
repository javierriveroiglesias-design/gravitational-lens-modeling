    "# FIX AT THE SOURCE: rather than patch every internal function that mishandles a bare scalar pixel_scales (we've now hit this bug in four different\n",
    "# places), we pass an explicit (y, x) tuple here from the start. This is the format this autolens install's internals actually expect everywhere -- a\n",
    "# bare float apparently isn't normalized to a tuple consistently across the whole codebase, which is the root cause of all four crashes so far.\n",
    "pixel_scales_tuple = (pixel_scale, pixel_scale)\n",
    "\n",
    "dataset = al.Imaging.from_fits(\n",
    "    data_path=f\"{dataset_path}/image.fits\",\n",
    "    noise_map_path=f\"{dataset_path}/noise_map.fits\",\n",
    "    psf_path=f\"{dataset_path}/psf.fits\",\n",
    "    pixel_scales=pixel_scales_tuple,   # tells PyAutoLens how to convert these pixels to arcsec\n",
    ")\n",
    "\n",
    "mask_radius_arcsec = 3.5   # matches COWLS' own preprocessing mask for this lens\n",
    "\n",
    "ny, nx = dataset.shape_native   # the (height, width) of our cutout, in pixels\n",
    "scale_y, scale_x = (dataset.pixel_scales, dataset.pixel_scales) \\\n",
    "    if isinstance(dataset.pixel_scales, (int, float)) else dataset.pixel_scales\n",
    "\n",
    "y0, x0 = (ny - 1) / 2.0, (nx - 1) / 2.0   # center of the image, in pixel coordinates\n",
    "\n",
    "# BUG WORKAROUND #2: al.Mask2D.circular() (the \"official\" way to build a circular mask) has a bug in this install that crashes regardless of what\n",
    "# arguments you give it. So instead, we build the circular mask \"by hand\" using plain numpy: for every pixel, compute its distance (in arcsec) from\n",
    "# the image center, then mark pixels farther than our chosen radius as masked.\n",
    "Y, X = np.ogrid[0:ny, 0:nx]   # coordinate grids for every pixel\n",
    "r_arcsec = np.sqrt(((Y - y0) * scale_y) ** 2 + ((X - x0) * scale_x) ** 2)   # distance-from-center, per pixel\n",
    "mask_array = r_arcsec > mask_radius_arcsec   # True = \"outside the circle\" = masked OUT (excluded from the fit)\n",
    "\n",
    "# origin=(0.0, 0.0) is passed explicitly here as an extra safeguard tied to BUG WORKAROUND #1 above.\n",
    "mask = al.Mask2D(mask=mask_array, pixel_scales=pixel_scales_tuple, origin=(0.0, 0.0))\n",
    "dataset = dataset.apply_mask(mask=mask)   # actually apply this mask to our dataset\n",
    "\n",
    "# Plot the masked image and its masked noise-map side by side.\n",
    "# np.where(mask, nan, data) means: \"wherever mask is True (masked out), replace with NaN so it displays as blank/white; otherwise show the real data.\"\n",
    "masked_image = np.where(dataset.mask, np.nan, dataset.data.native)\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 5))\n",
