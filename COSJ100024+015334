    "import autolens as al   # the actual PyAutoLens library\n",
    "\n",
    "# BUG WORKAROUND #1: in this particular autolens install, some internal functions expect `origin` and `pixel_scales` to always be (y, x) tuples, but\n",
    "# certain code paths pass in a single bare number instead, which crashes with an IndexError. We patch the offending function so it coerces a bare number\n",
    "# into a proper tuple automatically -- this doesn't change any actual physics or results, it just fixes a compatibility bug in this specific release.\n",
    "from autoarray.geometry import geometry_util as _geometry_util\n",
    "\n",
    "_original_central_scaled_coordinate_2d_from = _geometry_util.central_scaled_coordinate_2d_from\n",
    "\n",
    "def _patched_central_scaled_coordinate_2d_from(shape_native, pixel_scales, origin=(0.0, 0.0)):\n",
    "    if not isinstance(origin, (tuple, list)):\n",
    "        origin = (origin, origin)\n",
    "    if not isinstance(pixel_scales, (tuple, list)):\n",
    "        pixel_scales = (pixel_scales, pixel_scales)\n",
    "    return _original_central_scaled_coordinate_2d_from(\n",
    "        shape_native=shape_native, pixel_scales=pixel_scales, origin=origin\n",
    "    )\n",
    "\n",
