    "fwhm_pixels = fwhm_arcsec / pixel_scale\n",
    "\n",
    "# Converting FWHM to the \"sigma\" (standard deviation) parameter of a Gaussian: this conversion factor (2.3548) comes from the mathematical relationship\n",
    "# between a Gaussian's FWHM and its standard deviation.\n",
    "sigma_pixels = fwhm_pixels / 2.3548\n",
