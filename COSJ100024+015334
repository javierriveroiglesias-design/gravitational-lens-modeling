    "_over_sample_util.grid_2d_slim_over_sampled_via_mask_from = _patched_grid_2d_slim_over_sampled_via_mask_from\n",
    "\n",
    "# F444W is a \"long wavelength\" NIRCam channel. Longer wavelengths diffract more for a given telescope mirror size, so F444W has a coarser (blurrier)\n",
