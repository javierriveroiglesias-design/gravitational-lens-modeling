    "import numpy as np\n",
    "from astropy.io import fits             # reads/writes FITS files (the standard astronomy image format)\n",
    "from astropy.wcs import WCS             # handles the pixel <-> sky coordinate conversion\n",
    "from astropy.nddata import Cutout2D     # convenient tool for cropping a sub-image\n",
    "from astropy.wcs.utils import proj_plane_pixel_scales   # extracts the pixel scale from a WCS\n",
    "\n",
    "# Following the COWLS team's own preprocessing for this exact lens (they used a 3.5\" mask radius), we make our cutout comfortably bigger than that, so we\n",
    "# have some margin/context around the region we'll eventually mask.\n",
    "cutout_size = 10.0 * u.arcsec\n",
    "\n",
    "with fits.open(fits_path) as hdul:\n",
    "    # A FITS file is organized into \"HDUs\" (Header Data Units) -- think of them as named sections. \"SCI\" is the actual science image; its header contains\n",
    "    # the WCS information.\n",
    "    sci_header = hdul[\"SCI\"].header\n",
    "    wcs = WCS(sci_header)\n",
    "\n",
    "    # .astype(float) ensures we're working with floating-point numbers, since raw FITS data can sometimes be stored in more restrictive formats.\n",
    "    sci_data = hdul[\"SCI\"].data.astype(float)     # the actual brightness/flux values, pixel by pixel\n",
    "    err_data = hdul[\"ERR\"].data.astype(float)     # the *uncertainty* on each pixel's flux (see Step 3)\n",
    "\n",
    "    # Cutout2D does the pixel-position lookup (via wcs) and slices out a small square of the data centered on our target, of the requested angular size.\n",
    "    sci_cutout = Cutout2D(sci_data, position=target_coord, size=cutout_size, wcs=wcs)\n",
    "    err_cutout = Cutout2D(err_data, position=target_coord, size=cutout_size, wcs=wcs)\n",
    "\n",
    "    # pixel_scale tells us how many arcseconds one pixel corresponds to -- essential for converting between \"pixels\" and real angular/physical units\n",
    "    # later on (e.g. the Einstein radius is quoted in arcsec, not pixels).\n",
    "    pixel_scale = (proj_plane_pixel_scales(sci_cutout.wcs) * u.deg).to(u.arcsec).mean().value\n",
    "\n",
    "print(f\"Cutout shape: {sci_cutout.data.shape}, pixel scale: {pixel_scale:.4f} arcsec/pixel\")\n",
    "\n",
    "from astropy.visualization import ZScaleInterval   # a smart contrast-stretching algorithm for astronomical images\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Astronomical images often have a huge dynamic range (a few very bright pixels, lots of faint ones) -- a plain linear color scale would make\n",
    "# everything except the brightest pixel look black. ZScaleInterval picks good min/max display limits automatically, similar to what tools like DS9 use.\n",
    "vmin, vmax = ZScaleInterval().get_limits(sci_cutout.data[np.isfinite(sci_cutout.data)])\n",
    "\n",
    "plt.figure(figsize=(6, 6))\n",
    "plt.imshow(sci_cutout.data, cmap=\"gray\", vmin=vmin, vmax=3.4*vmax, origin=\"lower\")\n",
    "plt.title(\"COSJ100024+015334 cutout\")\n",
    "plt.xlabel(\"x (pixels)\")\n",
    "plt.ylabel(\"y (pixels)\")\n",
    "plt.colorbar(label=\"Flux\")\n",
    "plt.show()\n",
    "\n",
    "# WHAT TO LOOK FOR IN THIS PLOT:\n",
    "# - A bright, roughly circular blob near the center: this is the LENS galaxy itself (the foreground mass doing the bending).\n",
    "# - A curved, arc-like streak of light near/around it: this is the LENSED IMAGE of the background source galaxy -- its light has been bent by the\n",
    "#   lens galaxy's gravity into this einstein ring. This is direct visual evidence of gravitational lensing.\n",
    "# - Any other unrelated blobs elsewhere in the frame are just foreground or background galaxies that happen to share the field of view -- not part of\n",
    "#   this lens system.\n"
   ]
